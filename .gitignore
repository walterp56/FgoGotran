web/next-env.d.ts
web/.next-dev*.log

# Python virtual environments
.venv/
venv/
# Bytecode caches from Python utilities, including translation evaluation.
__pycache__/
.pytest_cache/
*.pyc
*.pyo
# Tool caches from local static checks; never part of the repository.
.mypy_cache/
.ruff_cache/
term_builder/venv
term_builder/fgo_terms.db
term_builder/fgo_terms.json
term_builder/atlas_*.json
term_builder/atlas_*.json.tmp
term_builder/atlas_voice_audio/

# Kotlin daemon
.kotlin/

# IDE
.idea/
.vscode/
*.iml

# Local machine-specific
local.properties
# Owner-only AWS analytics release choice. Never commit or auto-toggle this file.
/analytics-release.properties
*.jks
*.keystore
key.properties
google-services.json
.env
.env.*
!.env.example
!web/.env.example

# Claude Code
.claude/
.codex/

# Temp / doc files
*.docx
~$*.docx

# Local artifacts and research assets
doc/
image/
app/release/
release/
temp/
tmp_video_frames/
showcase/
tools/

# Story data: raw Atlas scripts, translated TSVs, inventories, ledgers, SQLite
# packs and downloadable chapter releases stay local. The builder, tools and
# docs are versioned; the story content itself is not.
/story_builder/work/
/release/cdn/story/
event-*.tsv
event-*.db
story.db
source-inventory.json
# Every SQLite file is a generated pack or a scratch copy; the build script is
# versioned instead. Chapter packs stay under work/, which the guard also checks.
*.db
*.db.tmp-*

# GitHub Actions typo guard
.github/workflow/

.agents/
term_builder/voice_tuning/
helper/
atlas_cache/
# Local Atlas sources, authorised JP captures, offline builds and playback evidence.
/story_assets/
video/
local-ai-studio/
.video_inspect/
.font_inspect/
tmp/
AWS/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.orig
*.rej
# Editor swap and backup files, including when the worktree is edited from WSL.
*.swp
*.swo
*~

# Local device and log evidence (screen dumps, adb captures) never leave the machine.
logcat*.txt
*logcat*.txt
*.logcat

# SQLite sidecars and packaged artifacts from local runs; the tracked schema is
# SQL text, never a database binary.
*.db-wal
*.db-shm
*.db-journal
*.apk
*.aab
# Device captures and heap dumps written by local debug runs.
captures/
*.hprof

# Local research documents; product guides remain versioned.
/docs/*

# Production test sources and committed fixtures are intentionally not ignored.
