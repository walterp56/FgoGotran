<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FgoGotran" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#EBEBE9</item>
        <item name="android:statusBarColor">#EBEBE9</item>
        <item name="android:navigationBarColor">#EBEBE9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- AppCompat dialog theme for overlay AlertDialogs from Service context -->
    <style name="Theme.FgoGotran.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">#FF212121</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="Theme.FgoGotran.Dialog.Light" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">#F5F5F2</item>
        <item name="android:windowIsFloating">true</item>
        <item name="colorAccent">#76518F</item>
        <item name="android:textColorPrimary">#292B2B</item>
        <item name="android:textColorSecondary">#606663</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
